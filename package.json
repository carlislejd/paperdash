{
  "name": "paperdash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm run dev:api' 'npm run dev:web'",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch apps/server/src/index.ts",
    "dev:ingest": "tsx watch apps/server/src/worker.ts",
    "build": "npm run typecheck && npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "build:ingest": "npm run build:api",
    "start:api": "node dist/server/apps/server/src/index.js",
    "start:ingest": "node dist/server/apps/server/src/worker.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx apps/server/src/migrate.ts",
    "ingest:status": "tsx apps/server/src/status.ts",
    "stats": "node scripts/paperdash.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "centrifuge": "^5.4.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "ioredis": "^5.8.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
