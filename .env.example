# Node 24. Copy to .env for local API/worker development; never commit secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# Empty = same-origin requests through Vite's /api proxy.
# Production: the public API origin, e.g. https://paperdash-api.onrender.com
# This is a PUBLIC browser build setting. Never put credentials in VITE_*.
VITE_API_URL=
# Public frontend origin for canonical/social preview URLs. Render automatically
# supplies RENDER_EXTERNAL_URL; set this override for a custom domain.
# Empty outside Render uses http://localhost:5173 and warns during production builds.
VITE_SITE_URL=
# Optional public token from Cloudflare Web Analytics. Runs only in a production
# build on the exact HTTPS custom domain configured in VITE_SITE_URL.
VITE_CF_WEB_ANALYTICS_TOKEN=
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Omit DATABASE_URL to use the durable local SQLite store.
# With Postgres, REDIS_URL is required for shared upstream request coordination.
# Run npm run db:migrate and launch npm run dev:ingest separately.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/paperdash
# REDIS_URL=redis://127.0.0.1:6379
DATA_DIR=.data
LOCAL_MAX_BYTES=536870912

# Default: collector embedded in the API only when DATABASE_URL is absent.
# Set false for an API with a standalone worker; do not run both collectors locally.
# EMBEDDED_COLLECTOR=false
# Initial managed-owner bootstrap supports automatic idempotent migrations.
# Set false after provisioning restricted runtime roles; see docs/OPERATIONS.md.
AUTO_MIGRATE=true

# Per-process admission, cached public reads and shared-IP launch limits.
MAX_SSE_CLIENTS=6000
API_READ_CACHE_MS=1000
API_RATE_LIMIT_PER_MINUTE=12000
API_PROFILE_RATE_LIMIT_PER_MINUTE=3000
SSE_CONNECT_RATE_LIMIT_PER_MINUTE=2000
WALLET_SNAPSHOT_TTL_MS=30000

UPSTREAM_ORIGIN=https://exchange.papertrade.xyz
STREAM_URL=wss://stream.papertrade.xyz/connection/websocket
# One upstream budget shared by the API replicas and collector through Redis.
UPSTREAM_REQUEST_SPACING_MS=250
UPSTREAM_CONCURRENCY=3
UPSTREAM_QUEUE_TIMEOUT_MS=8000
SUMMARY_INTERVAL_MS=2000
RECENT_INTERVAL_MS=10000
DIRECTORY_INTERVAL_MS=30000
# Reconcile source TVL history hourly; continuous collection records minute samples.
HISTORY_INTERVAL_MS=3600000
WALLET_INDEX_INTERVAL_MS=1000
WALLET_INDEX_REQUESTS_PER_TICK=2
